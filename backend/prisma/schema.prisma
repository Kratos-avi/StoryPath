generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  stories   Story[]
}

model Story {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime  @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  startNodeId Int?
  startNode   StoryNode? @relation("StoryStartNode", fields: [startNodeId], references: [id], onDelete: SetNull)
  nodes       StoryNode[] @relation("StoryNodes")
}

model StoryNode {
  id        Int      @id @default(autoincrement())
  storyId   Int
  story     Story    @relation("StoryNodes", fields: [storyId], references: [id], onDelete: Cascade)
  startFor  Story[]  @relation("StoryStartNode")

  content   String
  options   Json     @default("[]")

  createdAt DateTime @default(now())
}
